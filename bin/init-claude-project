#!/usr/bin/env bash
# init-claude-project — Interactive Claude Code project initializer
# Copies CLAUDE.md template, skills, and subagents into the target project.

set -euo pipefail

trap 'printf "\n%s\n" "Cancelled."; exit 130' INT

# ---------------------------------------------------------------------------
# Self-location
# ---------------------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"
TEMPLATES_DIR="$REPO_ROOT/config/claude_md_templates"
SKILLS_DIR="$REPO_ROOT/skills"
SUBAGENTS_DIR="$REPO_ROOT/subagents"

# ---------------------------------------------------------------------------
# Colors / formatting
# ---------------------------------------------------------------------------
BOLD=$'\033[1m'
DIM=$'\033[2m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
CYAN=$'\033[0;36m'
RED=$'\033[0;31m'
RESET=$'\033[0m'

# ---------------------------------------------------------------------------
# Helper: printing
# ---------------------------------------------------------------------------
print_header()  { printf "\n${BOLD}${CYAN}%s${RESET}\n\n" "$1"; }
print_success() { printf "${GREEN}  ✓ %s${RESET}\n" "$1"; }
print_warning() { printf "${YELLOW}  ⚠ %s${RESET}\n" "$1"; }
print_error()   { printf "${RED}  ✗ %s${RESET}\n" "$1"; }
print_info()    { printf "${DIM}  %s${RESET}\n" "$1"; }

# ---------------------------------------------------------------------------
# Helper: frontmatter parsing (pure bash — no awk/sed dependency on YAML libs)
# ---------------------------------------------------------------------------

# Read frontmatter block (lines between first and second ---) into $REPLY.
parse_frontmatter() {
    local file="$1" in_fm=0 fm=""
    while IFS= read -r line; do
        if [[ "$line" == "---" ]]; then
            if (( in_fm )); then
                REPLY="$fm"
                return 0
            fi
            in_fm=1
            continue
        fi
        if (( in_fm )); then
            fm+="$line"$'\n'
        fi
    done < "$file"
    REPLY=""
    return 1
}

# Extract a scalar value: get_frontmatter_field "key" "$frontmatter"
get_frontmatter_field() {
    local key="$1" fm="$2"
    while IFS= read -r line; do
        if [[ "$line" =~ ^${key}:[[:space:]]*(.*) ]]; then
            REPLY="${BASH_REMATCH[1]}"
            return 0
        fi
    done <<< "$fm"
    REPLY=""
    return 1
}

# Extract a YAML list into the array variable whose name is passed as $3.
# Usage: get_frontmatter_list "skills" "$fm" result_array
get_frontmatter_list() {
    local key="$1" fm="$2" arrname="$3"
    local in_list=0
    eval "$arrname=()"
    while IFS= read -r line; do
        if [[ "$line" =~ ^${key}: ]]; then
            in_list=1
            continue
        fi
        if (( in_list )); then
            if [[ "$line" =~ ^[[:space:]]*-[[:space:]]+(.*) ]]; then
                eval "$arrname+=(\"\${BASH_REMATCH[1]}\")"
            else
                break
            fi
        fi
    done <<< "$fm"
}

# Copy template body (everything after the closing ---) to stdout.
strip_frontmatter() {
    local file="$1" dashes=0
    while IFS= read -r line; do
        if [[ "$line" == "---" ]]; then
            (( ++dashes ))
            if (( dashes == 2 )); then
                # Consume the rest
                while IFS= read -r line; do
                    printf '%s\n' "$line"
                done
                return 0
            fi
            continue
        fi
        if (( dashes == 0 )); then
            # No frontmatter — emit everything
            printf '%s\n' "$line"
            while IFS= read -r line; do
                printf '%s\n' "$line"
            done
            return 0
        fi
    done < "$file"
}

# ---------------------------------------------------------------------------
# Discovery: skills
# ---------------------------------------------------------------------------
# Populates parallel arrays: ALL_SKILL_NAMES, ALL_SKILL_CATEGORIES, ALL_SKILL_PATHS
discover_all_skills() {
    ALL_SKILL_NAMES=()
    ALL_SKILL_CATEGORIES=()
    ALL_SKILL_PATHS=()
    local cat_dir skill_dir
    for cat_dir in "$SKILLS_DIR"/*/; do
        [ -d "$cat_dir" ] || continue
        local category
        category="$(basename "$cat_dir")"
        for skill_dir in "$cat_dir"*/; do
            [ -d "$skill_dir" ] || continue
            if [ -f "$skill_dir/SKILL.md" ]; then
                ALL_SKILL_NAMES+=("$(basename "$skill_dir")")
                ALL_SKILL_CATEGORIES+=("$category")
                ALL_SKILL_PATHS+=("$skill_dir")
            fi
        done
    done
}

# ---------------------------------------------------------------------------
# Discovery: subagents
# ---------------------------------------------------------------------------
# Populates: ALL_SUBAGENT_NAMES, ALL_SUBAGENT_PATHS
discover_all_subagents() {
    ALL_SUBAGENT_NAMES=()
    ALL_SUBAGENT_PATHS=()
    local f
    for f in "$SUBAGENTS_DIR"/*.md; do
        [ -f "$f" ] || continue
        local base
        base="$(basename "$f" .md)"
        [[ "$base" == "README" ]] && continue
        ALL_SUBAGENT_NAMES+=("$base")
        ALL_SUBAGENT_PATHS+=("$f")
    done
}

# ---------------------------------------------------------------------------
# Find skill path by name
# ---------------------------------------------------------------------------
find_skill_path() {
    local name="$1"
    local i
    for (( i=0; i<${#ALL_SKILL_NAMES[@]}; i++ )); do
        if [[ "${ALL_SKILL_NAMES[$i]}" == "$name" ]]; then
            REPLY="${ALL_SKILL_PATHS[$i]}"
            return 0
        fi
    done
    REPLY=""
    return 1
}

# ---------------------------------------------------------------------------
# Find subagent path by name
# ---------------------------------------------------------------------------
find_subagent_path() {
    local name="$1"
    local i
    for (( i=0; i<${#ALL_SUBAGENT_NAMES[@]}; i++ )); do
        if [[ "${ALL_SUBAGENT_NAMES[$i]}" == "$name" ]]; then
            REPLY="${ALL_SUBAGENT_PATHS[$i]}"
            return 0
        fi
    done
    REPLY=""
    return 1
}

# ---------------------------------------------------------------------------
# Helper: check if value is in an array
# ---------------------------------------------------------------------------
in_array() {
    local needle="$1"; shift
    local item
    for item in "$@"; do
        [[ "$item" == "$needle" ]] && return 0
    done
    return 1
}

# ---------------------------------------------------------------------------
# Step 1: Select project type
# ---------------------------------------------------------------------------
select_project_type() {
    local template_files=() template_names=() template_descs=() template_fms=()
    local f
    for f in "$TEMPLATES_DIR"/*.md; do
        [ -f "$f" ] || continue
        local base
        base="$(basename "$f" .md)"
        [[ "$base" == "README" ]] && continue

        # Must have frontmatter
        if ! parse_frontmatter "$f"; then
            continue
        fi
        local fm="$REPLY"
        local desc=""
        get_frontmatter_field "description" "$fm" && desc="$REPLY"
        [ -z "$desc" ] && continue

        template_files+=("$f")
        template_names+=("$base")
        template_descs+=("$desc")
        template_fms+=("$fm")
    done

    if (( ${#template_names[@]} == 0 )); then
        print_error "No templates found in $TEMPLATES_DIR"
        exit 1
    fi

    printf '\033[2J\033[H'
    print_header "Select a project type"
    local i
    for (( i=0; i<${#template_names[@]}; i++ )); do
        printf "  ${BOLD}%2d)${RESET} %-25s ${DIM}%s${RESET}\n" \
            "$((i+1))" "${template_names[$i]}" "${template_descs[$i]}"
    done
    printf "\n"

    while true; do
        printf "  Enter number (1-%d): " "${#template_names[@]}"
        read -r choice
        if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#template_names[@]} )); then
            SELECTED_TEMPLATE_FILE="${template_files[$((choice-1))]}"
            SELECTED_TEMPLATE_NAME="${template_names[$((choice-1))]}"
            SELECTED_TEMPLATE_FM="${template_fms[$((choice-1))]}"
            return 0
        fi
        print_warning "Invalid choice. Try again."
    done
}

# ---------------------------------------------------------------------------
# Checkbox toggle UI
# Generic: takes array of display names, array of recommended flags, sets
# SELECTED_INDICES array on return.
# ---------------------------------------------------------------------------
checkbox_menu() {
    local title="$1"; shift
    local -a display_names=()
    local -a recommended=()
    local -a categories=()
    local total="$1"; shift

    # Read display_names
    local i
    for (( i=0; i<total; i++ )); do
        display_names+=("$1"); shift
    done
    # Read recommended flags (1/0)
    for (( i=0; i<total; i++ )); do
        recommended+=("$1"); shift
    done
    # Read categories (may be empty strings)
    for (( i=0; i<total; i++ )); do
        categories+=("$1"); shift
    done

    # Initialize checked array from recommended
    local -a checked=()
    for (( i=0; i<total; i++ )); do
        checked+=("${recommended[$i]}")
    done

    while true; do
        printf '\033[2J\033[H'
        print_header "$title"
        printf "  ${DIM}Toggle: number, comma-list (${BOLD}1,3,5${RESET}${DIM}), or range (${BOLD}2-7${RESET}${DIM})  ${BOLD}a${RESET}${DIM}=all ${BOLD}n${RESET}${DIM}=none ${BOLD}d${RESET}${DIM}=done${RESET}\n\n"

        local prev_cat=""
        for (( i=0; i<total; i++ )); do
            # Category header
            if [[ -n "${categories[$i]}" && "${categories[$i]}" != "$prev_cat" ]]; then
                printf "\n  ${BOLD}${CYAN}%s${RESET}\n" "${categories[$i]}"
                prev_cat="${categories[$i]}"
            fi

            local mark=" "
            (( checked[i] )) && mark="x"
            local rec_label=""
            (( recommended[i] )) && rec_label=" ${DIM}(recommended)${RESET}"

            printf "  ${BOLD}%2d)${RESET} [%s] %s%s\n" "$((i+1))" "$mark" "${display_names[$i]}" "$rec_label"
        done
        printf "\n"

        printf "  > "
        read -r input

        case "$input" in
            d|D)
                SELECTED_INDICES=()
                for (( i=0; i<total; i++ )); do
                    (( checked[i] )) && SELECTED_INDICES+=("$i")
                done
                return 0
                ;;
            a|A)
                for (( i=0; i<total; i++ )); do
                    checked[$i]=1
                done
                ;;
            n|N)
                for (( i=0; i<total; i++ )); do
                    checked[$i]=0
                done
                ;;
            *)
                # Split on commas, then handle each token as a number or range
                IFS=',' read -ra tokens <<< "$input"
                local tok
                for tok in "${tokens[@]}"; do
                    tok="${tok// /}"  # strip whitespace
                    if [[ "$tok" =~ ^([0-9]+)-([0-9]+)$ ]]; then
                        local rstart="${BASH_REMATCH[1]}" rend="${BASH_REMATCH[2]}"
                        local r
                        for (( r=rstart; r<=rend; r++ )); do
                            if (( r >= 1 && r <= total )); then
                                local idx=$((r-1))
                                if (( checked[idx] )); then
                                    checked[$idx]=0
                                else
                                    checked[$idx]=1
                                fi
                            fi
                        done
                    elif [[ "$tok" =~ ^[0-9]+$ ]] && (( tok >= 1 && tok <= total )); then
                        local idx=$((tok-1))
                        if (( checked[idx] )); then
                            checked[$idx]=0
                        else
                            checked[$idx]=1
                        fi
                    fi
                done
                ;;
        esac
    done
}

# ---------------------------------------------------------------------------
# Step 2: Select skills
# ---------------------------------------------------------------------------
select_skills() {
    local rec_skills=()
    get_frontmatter_list "skills" "$SELECTED_TEMPLATE_FM" rec_skills

    local total=${#ALL_SKILL_NAMES[@]}
    local -a display_names=() recommended_flags=() cat_labels=()

    local i
    for (( i=0; i<total; i++ )); do
        display_names+=("${ALL_SKILL_NAMES[$i]}")
        cat_labels+=("${ALL_SKILL_CATEGORIES[$i]}")
        if in_array "${ALL_SKILL_NAMES[$i]}" "${rec_skills[@]+"${rec_skills[@]}"}"; then
            recommended_flags+=(1)
        else
            recommended_flags+=(0)
        fi
    done

    checkbox_menu "Select skills for ${SELECTED_TEMPLATE_NAME}" \
        "$total" \
        "${display_names[@]}" \
        "${recommended_flags[@]}" \
        "${cat_labels[@]}"

    CHOSEN_SKILL_NAMES=()
    CHOSEN_SKILL_PATHS=()
    for idx in "${SELECTED_INDICES[@]+"${SELECTED_INDICES[@]}"}"; do
        CHOSEN_SKILL_NAMES+=("${ALL_SKILL_NAMES[$idx]}")
        CHOSEN_SKILL_PATHS+=("${ALL_SKILL_PATHS[$idx]}")
    done
}

# ---------------------------------------------------------------------------
# Step 3: Select subagents
# ---------------------------------------------------------------------------
select_subagents() {
    local rec_subagents=()
    get_frontmatter_list "subagents" "$SELECTED_TEMPLATE_FM" rec_subagents

    local total=${#ALL_SUBAGENT_NAMES[@]}
    local -a display_names=() recommended_flags=() cat_labels=()

    local i
    for (( i=0; i<total; i++ )); do
        display_names+=("${ALL_SUBAGENT_NAMES[$i]}")
        cat_labels+=("")  # no categories for subagents
        if in_array "${ALL_SUBAGENT_NAMES[$i]}" "${rec_subagents[@]+"${rec_subagents[@]}"}"; then
            recommended_flags+=(1)
        else
            recommended_flags+=(0)
        fi
    done

    checkbox_menu "Select subagents for ${SELECTED_TEMPLATE_NAME}" \
        "$total" \
        "${display_names[@]}" \
        "${recommended_flags[@]}" \
        "${cat_labels[@]}"

    CHOSEN_SUBAGENT_NAMES=()
    CHOSEN_SUBAGENT_PATHS=()
    for idx in "${SELECTED_INDICES[@]+"${SELECTED_INDICES[@]}"}"; do
        CHOSEN_SUBAGENT_NAMES+=("${ALL_SUBAGENT_NAMES[$idx]}")
        CHOSEN_SUBAGENT_PATHS+=("${ALL_SUBAGENT_PATHS[$idx]}")
    done
}

# ---------------------------------------------------------------------------
# Step 4: Show summary
# ---------------------------------------------------------------------------
show_summary() {
    printf '\033[2J\033[H'
    print_header "Installation Summary"

    printf "  ${BOLD}Project type:${RESET}  %s\n" "$SELECTED_TEMPLATE_NAME"
    printf "  ${BOLD}Target:${RESET}        %s\n\n" "$(pwd)"

    printf "  ${BOLD}CLAUDE.md${RESET}      ← template (frontmatter stripped)\n"
    printf "  ${BOLD}CLAUDE.local.md${RESET} ← blank overrides file\n\n"

    if (( ${#CHOSEN_SKILL_NAMES[@]} > 0 )); then
        printf "  ${BOLD}Skills (%d):${RESET}\n" "${#CHOSEN_SKILL_NAMES[@]}"
        local s
        for s in "${CHOSEN_SKILL_NAMES[@]}"; do
            printf "    • %s\n" "$s"
        done
        printf "\n"
    else
        printf "  ${DIM}No skills selected.${RESET}\n\n"
    fi

    if (( ${#CHOSEN_SUBAGENT_NAMES[@]} > 0 )); then
        printf "  ${BOLD}Subagents (%d):${RESET}\n" "${#CHOSEN_SUBAGENT_NAMES[@]}"
        local s
        for s in "${CHOSEN_SUBAGENT_NAMES[@]}"; do
            printf "    • %s\n" "$s"
        done
        printf "\n"
    else
        printf "  ${DIM}No subagents selected.${RESET}\n\n"
    fi

    printf "  ${BOLD}Install to:${RESET}\n"
    printf "    ./CLAUDE.md\n"
    printf "    ./CLAUDE.local.md\n"
    (( ${#CHOSEN_SKILL_NAMES[@]} > 0 )) && printf "    .claude/skills/*/\n"
    (( ${#CHOSEN_SUBAGENT_NAMES[@]} > 0 )) && printf "    .claude/agents/\n"
    printf "\n"

    while true; do
        printf "  Proceed with installation? (y/n): "
        read -r confirm
        case "$confirm" in
            y|Y) return 0 ;;
            n|N) printf "\n"; print_info "Cancelled."; exit 0 ;;
            *)   print_warning "Enter y or n." ;;
        esac
    done
}

# ---------------------------------------------------------------------------
# Step 5: Install
# ---------------------------------------------------------------------------
install_selections() {
    print_header "Installing..."

    # --- CLAUDE.md ---
    if [ -f "./CLAUDE.md" ]; then
        printf "  ${YELLOW}CLAUDE.md already exists.${RESET}\n"
        while true; do
            printf "  Overwrite? (y/n): "
            read -r ow
            case "$ow" in
                y|Y) break ;;
                n|N) print_info "Skipping CLAUDE.md"; break ;;
                *)   print_warning "Enter y or n." ;;
            esac
        done
        if [[ "$ow" =~ ^[Yy]$ ]]; then
            strip_frontmatter "$SELECTED_TEMPLATE_FILE" > ./CLAUDE.md
            print_success "Overwrote CLAUDE.md"
        fi
    else
        strip_frontmatter "$SELECTED_TEMPLATE_FILE" > ./CLAUDE.md
        print_success "Created CLAUDE.md"
    fi

    # --- CLAUDE.local.md ---
    if [ ! -f "./CLAUDE.local.md" ]; then
        cat > ./CLAUDE.local.md << 'LOCALEOF'
# Project-Specific Overrides

<!-- Use this file for temporary notes, experiments, or overrides
     that shouldn't be committed to the main CLAUDE.md -->
LOCALEOF
        print_success "Created CLAUDE.local.md"
    else
        print_info "CLAUDE.local.md already exists (skipped)"
    fi

    # --- Skills ---
    if (( ${#CHOSEN_SKILL_NAMES[@]} > 0 )); then
        mkdir -p .claude/skills
        local i
        for (( i=0; i<${#CHOSEN_SKILL_NAMES[@]}; i++ )); do
            local sname="${CHOSEN_SKILL_NAMES[$i]}"
            local spath="${CHOSEN_SKILL_PATHS[$i]}"
            local dest=".claude/skills/$sname"

            if [ ! -d "$spath" ]; then
                print_warning "Skill not found on disk: $sname (skipped)"
                continue
            fi

            if [ -d "$dest" ]; then
                print_warning "Overwriting existing skill: $sname"
            fi

            mkdir -p "$dest"
            # Copy SKILL.md
            if [ -f "$spath/SKILL.md" ]; then
                cp "$spath/SKILL.md" "$dest/SKILL.md"
            fi
            # Copy references/ directory if it exists
            if [ -d "$spath/references" ]; then
                mkdir -p "$dest/references"
                cp -r "$spath/references/"* "$dest/references/" 2>/dev/null || true
            fi
            print_success "Installed skill: $sname"
        done
    fi

    # --- Subagents ---
    if (( ${#CHOSEN_SUBAGENT_NAMES[@]} > 0 )); then
        mkdir -p .claude/agents
        local i
        for (( i=0; i<${#CHOSEN_SUBAGENT_NAMES[@]}; i++ )); do
            local sname="${CHOSEN_SUBAGENT_NAMES[$i]}"
            local spath="${CHOSEN_SUBAGENT_PATHS[$i]}"
            local dest=".claude/agents/${sname}.md"

            if [ ! -f "$spath" ]; then
                print_warning "Subagent not found on disk: $sname (skipped)"
                continue
            fi

            if [ -f "$dest" ]; then
                print_warning "Overwriting existing subagent: $sname"
            fi

            cp "$spath" "$dest"
            print_success "Installed subagent: $sname"
        done
    fi

    printf "\n"
    print_success "Done! Project initialized with ${SELECTED_TEMPLATE_NAME} template."
    print_info "Run 'claude' in this directory to start working."
}

# ---------------------------------------------------------------------------
# Defaults mode: skip interactive selection, use template recommendations
# ---------------------------------------------------------------------------
install_defaults() {
    # Parse recommended skills/subagents from frontmatter
    local rec_skills=() rec_subagents=()
    get_frontmatter_list "skills" "$SELECTED_TEMPLATE_FM" rec_skills
    get_frontmatter_list "subagents" "$SELECTED_TEMPLATE_FM" rec_subagents

    CHOSEN_SKILL_NAMES=()
    CHOSEN_SKILL_PATHS=()
    local s
    for s in "${rec_skills[@]+"${rec_skills[@]}"}"; do
        if find_skill_path "$s"; then
            CHOSEN_SKILL_NAMES+=("$s")
            CHOSEN_SKILL_PATHS+=("$REPLY")
        else
            print_warning "Recommended skill not found: $s"
        fi
    done

    CHOSEN_SUBAGENT_NAMES=()
    CHOSEN_SUBAGENT_PATHS=()
    for s in "${rec_subagents[@]+"${rec_subagents[@]}"}"; do
        if find_subagent_path "$s"; then
            CHOSEN_SUBAGENT_NAMES+=("$s")
            CHOSEN_SUBAGENT_PATHS+=("$REPLY")
        else
            print_warning "Recommended subagent not found: $s"
        fi
    done
}

# ---------------------------------------------------------------------------
# CLI: parse a template name argument to skip the selection menu
# ---------------------------------------------------------------------------
resolve_template_by_name() {
    local name="$1"
    local f="$TEMPLATES_DIR/${name}.md"
    if [ ! -f "$f" ]; then
        print_error "Template not found: $name"
        printf "\n  Available templates:\n"
        local t
        for t in "$TEMPLATES_DIR"/*.md; do
            [ -f "$t" ] || continue
            local base
            base="$(basename "$t" .md)"
            [[ "$base" == "README" ]] && continue
            if parse_frontmatter "$t"; then
                printf "    %s\n" "$base"
            fi
        done
        printf "\n"
        exit 1
    fi

    if ! parse_frontmatter "$f"; then
        print_error "Template $name has no frontmatter"
        exit 1
    fi
    SELECTED_TEMPLATE_FILE="$f"
    SELECTED_TEMPLATE_NAME="$name"
    SELECTED_TEMPLATE_FM="$REPLY"
}

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------
show_usage() {
    printf "${BOLD}Usage:${RESET} init-claude-project [<template-name>] [--defaults]\n\n"
    printf "  Interactive project initializer for Claude Code.\n"
    printf "  Copies CLAUDE.md template, skills, and subagents into the current directory.\n\n"
    printf "${BOLD}Options:${RESET}\n"
    printf "  <template-name>    Skip the type-selection menu\n"
    printf "  --defaults         Use recommended skills/subagents (non-interactive)\n"
    printf "  --help, -h         Show this help\n\n"
    printf "${BOLD}Examples:${RESET}\n"
    printf "  init-claude-project                      # fully interactive\n"
    printf "  init-claude-project python-etl            # skip type menu\n"
    printf "  init-claude-project python-etl --defaults # non-interactive\n"
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
main() {
    local template_arg="" use_defaults=0

    # Parse CLI args
    while (( $# > 0 )); do
        case "$1" in
            --defaults) use_defaults=1; shift ;;
            --help|-h)  show_usage; exit 0 ;;
            -*)         print_error "Unknown flag: $1"; show_usage; exit 1 ;;
            *)          template_arg="$1"; shift ;;
        esac
    done

    # Discover available skills and subagents
    discover_all_skills
    discover_all_subagents

    # Step 1: Project type
    if [ -n "$template_arg" ]; then
        resolve_template_by_name "$template_arg"
    else
        select_project_type
    fi

    # Steps 2-3: Skills & subagents
    if (( use_defaults )); then
        install_defaults
    else
        select_skills
        select_subagents
    fi

    # Step 4: Summary & confirm
    show_summary

    # Step 5: Install
    install_selections
}

main "$@"
